# AI / marketing integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
GOOGLE_CLOUD_PROJECT=your-google-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional app config
APP_NAME=JARVIS
AFFILIATE_TAG=your-tag
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Distribution channels (leave unset to run those channels in manual/demo mode)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
X_ACCESS_TOKEN=
# TikTok: the Content Posting API requires an uploaded video asset. There is no
# video-generation step in this pipeline, so TikTok posts are always queued for
# manual upload rather than auto-published.

# Protects /api/worker/run from public misuse. Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` when this is set, so no extra config needed
# beyond setting the env var in both places.
CRON_SECRET=
